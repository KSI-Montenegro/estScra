# Fill these in locally; never commit .env.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=esstitor_site_phone_scraper
BRIGHTDATA_BROWSER_ZONE=estitorscraper2
PATULJAK_COOKIE=
# Full clone: 0. Source-only ZIP / fresh install without historical imports: 1.
GRADEN_SKIP_HISTORICAL_PHONE_BASELINE=0

# Replace with the bucket you intend this local installation to write to.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=YOUR_BUCKET_NAME
R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_IMAGE_DOMAIN
